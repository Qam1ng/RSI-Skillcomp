+    def vla_native_step(self, native_action: np.ndarray) -> tuple[bool, bool]:
+        """Advance one control period with a raw native-space action (OSC_POSE only).
+
+        Runtime-only: returns (terminated, truncated); failures raise.
+        """
+        env = self._require_env()
+        if self.controller != "OSC_POSE":
+            raise ValueError("vla_native_step requires the OSC_POSE controller")
+        if self._action_bounds is None:  # pragma: no cover - established at env creation
+            raise RuntimeError("LIBERO action bounds are unavailable")
+        action_array = np.asarray(native_action, dtype=np.float64).reshape(-1)
+        expected = int(self._action_bounds[0].size)
+        if action_array.size != expected:
+            raise ValueError(f"native action must have {expected} dims")
+        action_array = np.clip(action_array, *self._action_bounds)
+        native_result = env.step(action_array)
+        self._elapsed_steps += 1
+        (
+            self._raw_observation,
+            self._last_reward,
+            self._last_terminated,
+            self._last_truncated,
+            self._last_native_info,
+        ) = self._unpack_native_result(native_result)
+        return bool(self._last_terminated), bool(self._last_truncated)
+
