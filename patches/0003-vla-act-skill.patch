diff --git a/src/cap_harness/vla_client.py b/src/cap_harness/vla_client.py
new file mode 100644
index 0000000..b7f3f47
--- /dev/null
+++ b/src/cap_harness/vla_client.py
@@ -0,0 +1,68 @@
+"""Minimal openpi policy-server client for vla_act (local patch #3).
+
+Observation recipe copied from openpi examples/libero/main.py so the policy
+sees exactly its training-time inputs: both camera images flipped then
+resize_with_pad to 224, uint8; 8-dim state = eef pos (3) + quat->axis-angle (3)
++ gripper qpos (2).
+"""
+from __future__ import annotations
+
+import math
+import os
+from typing import Any, Mapping
+
+import numpy as np
+
+
+class VlaPolicyClient:
+    _instance = None
+
+    @classmethod
+    def shared(cls) -> "VlaPolicyClient":
+        if cls._instance is None:
+            cls._instance = cls()
+        return cls._instance
+
+    def __init__(self) -> None:
+        from openpi_client import websocket_client_policy
+
+        host = os.environ.get("CAP_VLA_HOST", "127.0.0.1")
+        port = int(os.environ.get("CAP_VLA_PORT", "8000"))
+        self._client = websocket_client_policy.WebsocketClientPolicy(host=host, port=port)
+
+    def infer(self, element: Mapping[str, Any]) -> np.ndarray:
+        return np.asarray(self._client.infer(dict(element))["actions"])
+
+
+def _quat2axisangle(quat: np.ndarray) -> np.ndarray:
+    # Copied from robosuite transform_utils (via openpi examples/libero).
+    quat = np.array(quat, dtype=np.float64, copy=True)
+    if quat[3] > 1.0:
+        quat[3] = 1.0
+    elif quat[3] < -1.0:
+        quat[3] = -1.0
+    den = np.sqrt(1.0 - quat[3] * quat[3])
+    if math.isclose(float(den), 0.0):
+        return np.zeros(3)
+    return (quat[:3] * 2.0 * math.acos(quat[3])) / den
+
+
+def compose_libero_observation(raw: Mapping[str, Any], prompt: str,
+                               resize: int = 224) -> dict[str, Any]:
+    from openpi_client import image_tools
+
+    img = np.ascontiguousarray(np.asarray(raw["agentview_image"])[::-1, ::-1])
+    wrist = np.ascontiguousarray(np.asarray(raw["robot0_eye_in_hand_image"])[::-1, ::-1])
+    img = image_tools.convert_to_uint8(image_tools.resize_with_pad(img, resize, resize))
+    wrist = image_tools.convert_to_uint8(image_tools.resize_with_pad(wrist, resize, resize))
+    state = np.concatenate([
+        np.asarray(raw["robot0_eef_pos"], dtype=np.float32).reshape(-1),
+        _quat2axisangle(np.asarray(raw["robot0_eef_quat"], dtype=np.float64)).astype(np.float32),
+        np.asarray(raw["robot0_gripper_qpos"], dtype=np.float32).reshape(-1),
+    ])
+    return {
+        "observation/image": img,
+        "observation/wrist_image": wrist,
+        "observation/state": state,
+        "prompt": str(prompt),
+    }
