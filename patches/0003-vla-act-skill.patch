+    def vla_act(
+        self,
+        prompt: str,
+        max_steps: int = 240,
+        replan_steps: int = 5,
+    ) -> ExecutionResult:
+        """Delegate control to the configured VLA policy server for one sub-task."""
+        if not isinstance(prompt, str) or not prompt.strip():
+            return ExecutionResult(
+                ok=False, steps_executed=0,
+                error=ApiError(code=ErrorCode.INVALID_REQUEST,
+                               message="prompt must be a non-empty string"))
+        if (type(max_steps) is not int or max_steps <= 0
+                or type(replan_steps) is not int or replan_steps <= 0):
+            return ExecutionResult(
+                ok=False, steps_executed=0,
+                error=ApiError(code=ErrorCode.INVALID_REQUEST,
+                               message="max_steps and replan_steps must be positive ints"))
+        if getattr(self._adapter, "controller", None) != "OSC_POSE" or not hasattr(
+                self._adapter, "vla_native_step"):
+            return ExecutionResult(
+                ok=False, steps_executed=0,
+                error=ApiError(code=ErrorCode.UNSUPPORTED,
+                               message="vla_act requires an OSC_POSE-mode LIBERO adapter"))
+        try:
+            from cap_harness.vla_client import VlaPolicyClient, compose_libero_observation
+            client = VlaPolicyClient.shared()
+        except Exception as exc:
+            return ExecutionResult(
+                ok=False, steps_executed=0,
+                error=ApiError(code=ErrorCode.UNSUPPORTED,
+                               message=f"vla client unavailable: {exc}",
+                               details={"exception_type": type(exc).__name__}))
+        steps = 0
+        terminated = truncated = False
+        try:
+            while steps < max_steps and not terminated and not truncated:
+                raw = self._adapter.raw_native_observation
+                if raw is None:
+                    return ExecutionResult(
+                        ok=False, steps_executed=steps,
+                        error=ApiError(code=ErrorCode.ADAPTER_FAILED,
+                                       message="no native observation available"))
+                chunk = client.infer(compose_libero_observation(raw, prompt))
+                for action in chunk[:replan_steps]:
+                    terminated, truncated = self._adapter.vla_native_step(
+                        np.asarray(action))
+                    steps += 1
+                    if terminated or truncated or steps >= max_steps:
+                        break
+        except Exception as exc:
+            return ExecutionResult(
+                ok=False, steps_executed=steps,
+                error=ApiError(code=ErrorCode.ADAPTER_FAILED,
+                               message=f"vla_act failed: {exc}",
+                               details={"exception_type": type(exc).__name__}))
+        # 契约：终止/截断的执行不得自称 ok（成功即截断的收尾惯例同 move 调用）。
+        # 程序侧以 result.terminated 作为"任务级完成"的信号。
+        ended = terminated or truncated
+        return ExecutionResult(
+            ok=not ended, steps_executed=steps,
+            terminated=terminated, truncated=truncated,
+            error=self._terminal_error(terminated, truncated) if ended else None,
+            diagnostics={"prompt": prompt, "replan_steps": replan_steps,
+                         "policy": "vla-server", "episode_ended": ended})
+
